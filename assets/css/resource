    <script>
        // Swap every standalone "Kenya"/"Kenyan" in visible text with the user's country.
        // Word boundaries (\b) protect words like "Kenyatta" from being touched.
        function swapCountryInText(country) {
            if (!country || country === 'Kenya') return;
            const skipTags = { SCRIPT: 1, STYLE: 1, NOSCRIPT: 1, TEXTAREA: 1, INPUT: 1 };
            const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
                acceptNode: function (n) {
                    if (!n.parentNode || skipTags[n.parentNode.nodeName]) return NodeFilter.FILTER_REJECT;
                    return /\bKenyan?\b/.test(n.nodeValue) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
                }
            });
            const nodes = [];
            let n;
            while ((n = walker.nextNode())) nodes.push(n);
            nodes.forEach(function (node) {
                node.nodeValue = node.nodeValue
                    .replace(/\bKenyan\b/g, country)
                    .replace(/\bKenya\b/g, country);
            });
            // Also fill the explicit placeholders inside the free pricing card
            document.querySelectorAll('.dyn-country').forEach(function (el) {
                el.textContent = country;
            });
        }

        function applyPricingForCountry(country) {
            const kenyaBox = document.getElementById('kenya-pricing');
            const freeBox = document.getElementById('non-kenya-pricing');
            const heading = document.getElementById('pricing-heading');
            const subheading = document.getElementById('pricing-subheading');
            if (country === 'Kenya') {
                if (kenyaBox) kenyaBox.style.display = '';
                if (freeBox) freeBox.style.display = 'none';
            } else {
                if (kenyaBox) kenyaBox.style.display = 'none';
                if (freeBox) freeBox.style.display = '';
                if (heading) heading.innerHTML = 'How Much Does <span>It Cost?</span>';
                if (subheading) subheading.style.display = 'none';
            }
        }

        // Rewrite every wa.me link's prefilled text to mention the visitor's country.
        function patchWhatsAppLinks(country) {
            const safeCountry = country || 'your country';
            const message = "Hello, I'm interested in your ISP software from " + safeCountry;
            const encoded = encodeURIComponent(message);
            document.querySelectorAll('a[href*="wa.me/"]').forEach(function (link) {
                try {
                    const url = new URL(link.href);
                    url.searchParams.set('text', message);
                    link.href = url.toString();
                } catch (e) {
                    // Fallback for browsers that choke on URL with relative refs
                    const base = link.href.split('?')[0];
                    link.href = base + '?text=' + encoded;
                }
            });
        }

        function updateCountryText(country) {
            const userCountryElement = document.getElementById('user-country');
