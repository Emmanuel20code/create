            // Update the <title> tag
            const titleElement = document.querySelector('title');
            if (titleElement) titleElement.textContent = `Free Isp Billing Software in ${country}`;
        }

        function applyCountry(country) {
            console.log('Applying country:', country);
            applyPricingForCountry(country);
            swapCountryInText(country);
            patchWhatsAppLinks(country);
            updateCountryText(country);
        }

        function getUserCountry() {
            // Manual override for testing: append ?country=Nigeria to the URL
            const override = new URLSearchParams(location.search).get('country');
            if (override) {
                applyCountry(override);
                return;
            }
            fetch('https://api.bigdatacloud.net/data/reverse-geocode-client')
                .then(response => response.json())
